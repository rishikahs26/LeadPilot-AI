# ============================================================
# LeadPilot — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# -----------------------------------------------
# REQUIRED: Google Gemini API Key
# -----------------------------------------------
# Get a free key at: https://aistudio.google.com/app/apikey
# Free tier: 15 RPM, 1M tokens/day with Gemini 3.8 Flash
# The app will show a clear error message if this is missing.
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------
# OPTIONAL: Next.js public URL (for deployment)
# -----------------------------------------------
# Set this to your Vercel deployment URL when deploying.
# Leave empty for local development.
# NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
